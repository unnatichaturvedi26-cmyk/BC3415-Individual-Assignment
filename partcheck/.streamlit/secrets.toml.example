# Copy to .streamlit/secrets.toml (never commit that file) or paste into Streamlit Cloud > App settings > Secrets.
# APP_PASSWORD = "choose-a-password"     # optional: asks visitors for a password
# MODEL_REPO = "unnati002/review-triage-files"
# MODEL_REVISION = "main"                # pin a commit hash so the models never change under you
# MAX_ROWS = "300"                       # most reviews analysed per dashboard run
# HF_TOKEN = "hf_..."                    # only if the model repo is private
